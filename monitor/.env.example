# 复制到 ~/.mail-monitor/.env 后填写（scripts/install.sh 会帮你复制）。这个文件里有秘密，不要提交到仓库。

# ---- 邮件层（默认不用改）----
# MAIL_MONITOR_NODE_BIN=/usr/local/bin/node
# MAIL_MONITOR_BRIDGE=/Users/你的用户名/thunderbird-mcp/mcp-bridge.cjs
# 只看这些账号（id 或名字的一部分，逗号分隔）；不填 = 全部
# MAIL_MONITOR_ACCOUNTS=
# 每次巡检回看几天（只是为了容错，去重靠数据库）
MAIL_MONITOR_DAYS_BACK=2
# 时区，用来换算截止日期和显示时间
MAIL_MONITOR_TZ=Asia/Dubai

# ---- 模型后端：api | claude ----
# api（默认）= 用下面的 API key，按量付费
# claude = 用你 Mac 上已登录的 Claude Code（Claude Pro / Max 订阅，不用 key，只限自己用）。先在终端运行 claude 登录，再跑 mail-monitor doctor
MAIL_MONITOR_LLM=api
# Claude 订阅版的模型，默认 sonnet；想省订阅用量可以改成 haiku
# MAIL_MONITOR_CLAUDE_MODEL=sonnet
# launchd 定时跑时找不到 claude，就写完整路径（终端里 which claude 能看到）
# MAIL_MONITOR_CLAUDE_BIN=/Users/你的用户名/.local/bin/claude
# 一句话介绍你自己，模型判断"谁、要不要管"时会参考（可不填）
# MAIL_MONITOR_PROFILE="MBZUAI 在读硕士，研究方向 X；正在找 AI Agent 方向的工作；导师是 Prof. Y"

# ---- API key 版（OpenAI 兼容接口，默认 DeepSeek；MAIL_MONITOR_LLM=api 时用）----
# 填你的 key。留空又不用 Claude 订阅版 = 不用模型：规则没覆盖的邮件一律按"拿不准"推送
DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# deepseek-chat 已于 2026-07-24 停用，现在用 deepseek-flash（便宜，分诊够用）或 deepseek-v4-pro
LLM_MODEL=deepseek-flash
# 原样并进请求体的额外参数（JSON 对象）。用 DeepSeek 时默认会关掉思考模式；写 {} 就什么都不加
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# ---- 推送：console | notify_hub | lark_app | lark_webhook ----
# 先用 console 在终端里看效果。
# 装了本机通知网关 notify-hub（https://github.com/yuhang2551/notify-hub）的，改成 notify_hub：
#   Lark 凭证、夜里免打扰、去重、失败重发都归它管，下面 LARK_ 开头的几项就不用填了
# 不用 notify-hub 的，接好 Lark 后改成 lark_app（应用机器人）或 lark_webhook（群自定义机器人）
MAIL_MONITOR_NOTIFY=console
# launchd 定时跑时找不到 notify-hub，就写完整路径（终端里 which notify-hub 能看到）；不写也会去 ~/.local/bin 里找
# MAIL_MONITOR_NOTIFY_HUB_BIN=/Users/你的用户名/.local/bin/notify-hub
# 飞书国内版把下面改成 https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com
# 应用机器人（lark_app；开发者后台 → 应用 → 凭证与基础信息）
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=
# 收件方：群 chat_id（mail-monitor lark-chats 查）或你的 open_id（--email 查）
# LARK_RECEIVE_ID=oc_xxx
# 收件方类型一般不用填：oc_ 开头按群发，ou_ 开头按个人发；填了就以填的为准（chat_id / open_id / union_id / email）
# LARK_RECEIVE_ID_TYPE=
# 群自定义机器人（lark_webhook；有的租户没有这个入口）
# LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxx
# LARK_WEBHOOK_SECRET=

# ---- 行动开关（写邮箱的动作默认全关）----
# 给"需要处理"的邮件打 Thunderbird 标签（$label4 = To Do）
MAIL_MONITOR_ACTION_TAG=false
# MAIL_MONITOR_ACTION_TAG_KEY=$label4
